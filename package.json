{
	"name": "emdash-plugin-sitegraph",
	"version": "0.1.0",
	"description": "A living dependency map for EmDash sites: content, URLs, internal links and documented dependencies, with change-impact preview.",
	"type": "module",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./admin": "./src/admin/index.tsx"
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"dev": "tsdown src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "*",
		"emdash": ">=1.2.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@cloudflare/kumo": "2.6.0",
		"@types/react": "^19.0.0",
		"emdash": "1.2.0",
		"react": "19.2.4",
		"tsdown": "^0.20.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"keywords": ["emdash", "emdash-plugin"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ravalkrushna1/sitegraph.git"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.33.0"
}
