{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "sitegraph-lite",
	"name": "SiteGraph Lite",
	"publisher": "did:plc:2vgwjmqe2e6u72wl5uyumrc2",

	"license": "MIT",
	"author": { "name": "Krushna Raval" },
	"security": { "url": "https://github.com/ravalkrushna1/sitegraph/security/advisories/new" },
	"description": "Finds broken internal links and shows what depends on a page before you change it.",
	"repo": "https://github.com/ravalkrushna1/sitegraph",
	"keywords": ["links", "broken links", "dependencies", "impact", "seo"],

	"release": {
		"artifacts": {
			"icon": { "file": "./images/icon.png" },
			"screenshots": [
				{ "file": "./images/overview.jpg" },
				{ "file": "./images/impact.jpg" },
				{ "file": "./images/document.jpg" }
			]
		}
	},

	// Trust contract. Read-only: it reads published entries and collection schemas to find
	// links, and keeps its map in its own storage. No content writes, no network.
	// Changing this between releases needs a version bump (installed sites re-consent).
	"capabilities": ["content:read", "schema:read"],
	"allowedHosts": [],
	"storage": {
		"nodes": { "indexes": ["type", "active", "search", "provenance", "resolved"] },
		"edges": { "indexes": ["sourceNodeId", "targetNodeId", "provenance", "active"] }
	},
	"admin": {
		"pages": [
			{ "path": "/overview", "label": "SiteGraph", "icon": "graph", "group": "SiteGraph" },
			{ "path": "/explore", "label": "Explore", "icon": "magnifying-glass", "group": "SiteGraph" },
			{ "path": "/document", "label": "Document", "icon": "note-pencil", "group": "SiteGraph" }
		],
		"widgets": [{ "id": "overview", "title": "SiteGraph", "size": "half" }]
	}
}
